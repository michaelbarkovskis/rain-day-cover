# PayPal sandbox: developer.paypal.com → Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Printed by `npm run sandbox:check` on first run
PAYPAL_PLAN_ID=
# Sandbox *personal* account email (Testing Tools → Sandbox Accounts) that receives test payouts
PAYPAL_SANDBOX_RECEIVER_EMAIL=

# Supabase: project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Production DB connection for `npm run db:push` (Session pooler string)
SUPABASE_DB_URL=

# Passcode for the /underwriter dashboard
UNDERWRITER_PASSCODE=
